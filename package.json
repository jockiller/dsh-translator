{
  "name": "dsh-translator-pro",
  "version": "0.1.3",
  "description": "DSH Input Translator: 输入框悬浮快捷翻译与历史找回挂件 (支持当前会话模型 / 智谱 GLM-4-Flash / 自定义 OpenAI 兼容端点)",
  "type": "module",
  "scripts": {
    "sync-version": "node scripts/sync-version.js",
    "prepack": "node scripts/sync-version.js"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "assets"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "translator",
    "translation",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jockiller/dsh-translator.git"
  },
  "author": "jockiller",
  "bugs": {
    "url": "https://github.com/jockiller/dsh-translator/issues"
  },
  "homepage": "https://github.com/jockiller/dsh-translator#readme",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
